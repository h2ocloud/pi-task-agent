# Copy to ~/.config/pi-tg-bridge/env and chmod 600. Do not commit the real file.

BOT_TOKEN=
OWNER_ID=
CHAT_ONLY_USERS=
GROUPS=

# pi binary and the provider / model aliases configured in pi.
PI_BIN=/opt/homebrew/bin/pi
PI_PROVIDER=spark
# PI_MODEL_MAIN=spark-main
# PI_MODEL_FAST=spark-fast
# PI_MODEL_THINK=spark-think
# PI_MODEL_VISION=spark-vision
# Extra aliases, comma-separated. Example: PI_MODELS=draft=my-draft
# PI_MODELS=

# Speech-to-text. POST {ASR_URL}/transcribe with a multipart field named audio.
# Leave empty to disable voice messages.
# ASR_URL=http://127.0.0.1:9700

# Planner / verifier calls. OpenAI-compatible /v1/chat/completions.
# SPARK_ENV=~/.config/spark-home/api.env
# That file may define SPARK_HOME_BASE and SPARK_HOME_KEY.

# Gmail sender for the gmail-send-safe skill / pitg-mail (draft-then-confirm). Kept out of the repo.
# GMAIL_ACCOUNT=you@example.com
# GMAIL_CLIENT=your-gog-client

# Skills: ondemand (default) | all | off. Keyword matches are capped; always-skills are not.
# PITG_SKILLS=ondemand
# PITG_SKILL_LIMIT=3
# PITG_HOME=~/.pi-tg
# PITG_COMPACT_AT=40000
# PITG_STEP_CTX=45000
# PITG_LANG=en
# PITG_DEBOUNCE=2.5   # seconds to merge a burst of messages into one (0 = off)
# Dashboard: http://127.0.0.1:8787/  (PITG_DASH=0 disables, PITG_DASH_PORT=8787)
# PITG_LOG=

# auto: local server while it answers, else Grok if XAI_API_KEY is set.
# local: never call Grok. grok: subscription even when the local server is up.
# PITG_PROVIDER=auto
# Seconds a grok/chatgpt run may wait for its first output before falling back to local (0 = off).
# PITG_FIRST_TOKEN_S=30
# XAI_API_KEY=
# PI_GROK_BASE=https://api.x.ai/v1
# PI_GROK_FAST=grok-4-1-fast-non-reasoning
# PI_GROK_MAIN=grok-build-0.1
# Heavier flagship, not the default: PI_GROK_MAIN=grok-4.7

# Optional LINE channel. Push quota is monthly; replies use the free reply token.
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
# LINE_OWNER_ID=
# LINE_CHAT_ONLY_USERS=
# LINE_PORT=18789
# LINE_BIND=127.0.0.1
